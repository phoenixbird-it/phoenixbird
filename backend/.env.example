# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (leave DATABASE_URL empty to use local SQLite)
# Production example: postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# CORS - comma separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email (used for enquiry / contact notifications)
# For local development, leave EMAIL_BACKEND as console backend to print emails to the terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=phoenixbirdspsk@gmail.com
ENQUIRY_RECEIVER_EMAIL=phoenixbirdspsk@gmail.com

# AWS S3 (production media storage) - set USE_S3=True to enable
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1

SECURE_SSL_REDIRECT=True
