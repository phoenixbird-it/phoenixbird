# Production environment for www.phoenixbirds.in
# Backend and frontend share the same domain; a reverse proxy (nginx/CloudFront/etc.)
# routes https://www.phoenixbirds.in/api/*, /admin/*, /static/*, /media/* to this Django app
# and everything else to the built React app.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=www.phoenixbirds.in,phoenixbirds.in

# Database - use the real RDS/Postgres connection string in production
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# CORS - same-origin path-based routing means the browser never makes a
# cross-origin request, but keep this set correctly in case that changes.
CORS_ALLOWED_ORIGINS=https://www.phoenixbirds.in,https://phoenixbirds.in

# Email (used for enquiry / contact notifications)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=phoenixbirdspsk@gmail.com
EMAIL_HOST_PASSWORD=use-a-gmail-app-password-here
DEFAULT_FROM_EMAIL=phoenixbirdspsk@gmail.com
ENQUIRY_RECEIVER_EMAIL=phoenixbirdspsk@gmail.com

# Public frontend URL, used to build sitemap.xml entries
FRONTEND_BASE_URL=https://www.phoenixbirds.in

# AWS S3 (production media storage) - set USE_S3=True to enable
USE_S3=True
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1

SECURE_SSL_REDIRECT=True
